<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <EditText
        android:id="@+id/editTextLiczbaKostek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Podaj liczbę kostek"
        android:inputType="number"
        android:gravity="center" />

    <Button
        android:id="@+id/buttonLosuj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Losuj" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonRosnaco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Rosnąco" />

        <Button
            android:id="@+id/buttonMalejaco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Malejąco" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wylosowane kostki:"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="8dp" />

    <GridLayout
        android:id="@+id/gridKostki"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="5"
        android:alignmentMode="alignMargins" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wyniki:"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewWyniki"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tutaj pojawią się wyniki"
        android:textSize="16sp"
        android:padding="8dp" />

</LinearLayout>
